root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{kt,kts,gradle,xml,xsd,dtd,rng,dita,ditamap,xsl,xslt,svg,html,css,js,json,yml,yaml,md,properties}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
