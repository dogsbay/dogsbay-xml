<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Glossary Entry" icon="" publicID="-//OASIS//DTD DITA Glossary Entry//EN" systemID="glossentry.dtd" extensions="dita xml">
	<root name="glossentry">
		<namespace prefix="" uri=""/>
	</root>

	<!-- Inline -->
	<fragment block="false" name="bold" key="Alt+Shift+B" order="0" icon="">&lt;b&gt;${cursor}${selection}&lt;/b&gt;</fragment>
	<fragment block="false" name="italic" key="Alt+Shift+I" order="1" icon="">&lt;i&gt;${cursor}${selection}&lt;/i&gt;</fragment>
	<fragment block="false" name="codeph" key="Alt+Shift+K" order="2" icon="">&lt;codeph&gt;${cursor}${selection}&lt;/codeph&gt;</fragment>
	<fragment block="false" name="xref" key="Alt+Shift+X" order="3" icon="">&lt;xref href="${cursor}" format="dita"/&gt;</fragment>

	<!-- Glossentry-specific structures -->
	<fragment block="true" name="glossterm" key="Alt+Shift+T" order="4" icon="">&lt;glossterm&gt;${cursor}&lt;/glossterm&gt;</fragment>
	<fragment block="true" name="glossdef" key="Alt+Shift+D" order="5" icon="">&lt;glossdef&gt;${cursor}&lt;/glossdef&gt;</fragment>
	<fragment block="true" name="glossAlt (abbreviation)" key="Alt+Shift+A" order="6" icon="">&lt;glossAlt&gt;
	&lt;glossAbbreviation&gt;${cursor}&lt;/glossAbbreviation&gt;
&lt;/glossAlt&gt;</fragment>
	<fragment block="true" name="glossAlt (acronym)" key="Alt+Shift+R" order="7" icon="">&lt;glossAlt&gt;
	&lt;glossAcronym&gt;${cursor}&lt;/glossAcronym&gt;
&lt;/glossAlt&gt;</fragment>

	<!-- Blocks -->
	<fragment block="true" name="paragraph" key="Alt+Shift+P" order="8" icon="">&lt;p&gt;${cursor}&lt;/p&gt;</fragment>
	<fragment block="true" name="note" key="Alt+Shift+N" order="9" icon="">&lt;note&gt;${cursor}&lt;/note&gt;</fragment>

	<xpath name="Terms" xpath="//glossterm | //glossdef | //glossAlt" default="true" showElementNames="true" showElementContent="true" showAttributes="false" showAttributeNames="false"/>
	<xpath name="Titles" xpath="//title" default="false" showElementNames="false" showElementContent="true" showAttributes="false" showAttributeNames="false"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
