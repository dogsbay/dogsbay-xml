<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Subject Scheme" icon="" publicID="-//OASIS//DTD DITA Subject Scheme Map//EN" systemID="subjectScheme.dtd" extensions="ditamap">
	<root name="subjectScheme">
		<namespace prefix="" uri=""/>
	</root>

	<!-- Subjects: the vocabulary itself -->
	<fragment block="true" name="subjectdef" key="Alt+Shift+S" order="0" icon="">&lt;subjectdef keys="${cursor}"/&gt;</fragment>
	<fragment block="true" name="subjectdef (with narrower subjects)" key="Alt+Shift+N" order="1" icon="">&lt;subjectdef keys="${cursor}"&gt;
	&lt;subjectdef keys=""/&gt;
&lt;/subjectdef&gt;</fragment>
	<fragment block="true" name="subjectHead (grouping, no key)" key="Alt+Shift+H" order="2" icon="">&lt;subjectHead&gt;
	&lt;subjectHeadMeta&gt;
		&lt;navtitle&gt;${cursor}&lt;/navtitle&gt;
	&lt;/subjectHeadMeta&gt;
&lt;/subjectHead&gt;</fragment>

	<!-- Bindings: what the vocabulary governs. The bound subject names the dimension and is not itself a legal value. -->
	<fragment block="true" name="enumerationdef (bind an attribute)" key="Alt+Shift+E" order="3" icon="">&lt;enumerationdef&gt;
	&lt;attributedef name="${cursor}"/&gt;
	&lt;subjectdef keyref=""/&gt;
&lt;/enumerationdef&gt;</fragment>
	<fragment block="true" name="enumerationdef (for one element)" key="Alt+Shift+L" order="4" icon="">&lt;enumerationdef&gt;
	&lt;elementdef name="${cursor}"/&gt;
	&lt;attributedef name=""/&gt;
	&lt;subjectdef keyref=""/&gt;
&lt;/enumerationdef&gt;</fragment>
	<fragment block="true" name="defaultSubject" key="Alt+Shift+D" order="5" icon="">&lt;defaultSubject keyref="${cursor}"/&gt;</fragment>

	<!-- Composition -->
	<fragment block="true" name="schemeref" key="Alt+Shift+R" order="6" icon="">&lt;schemeref href="${cursor}"/&gt;</fragment>

	<xpath name="Controlled Values" xpath="//enumerationdef | //attributedef | //elementdef" default="true" showElementNames="true" showElementContent="false" showAttributes="true" showAttributeNames="true"/>
	<xpath name="Subjects" xpath="//subjectdef | //subjectHead" default="false" showElementNames="true" showElementContent="false" showAttributes="true" showAttributeNames="true"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
