<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Concept" icon="" publicID="-//OASIS//DTD DITA Concept//EN" systemID="concept.dtd" extensions="dita xml">
	<root name="concept">
		<namespace prefix="" uri=""/>
	</root>

	<!-- Paragraph and inline -->
	<fragment block="true" name="paragraph" key="Alt+Shift+P" order="0" icon="">&lt;p&gt;${cursor}&lt;/p&gt;</fragment>
	<fragment block="false" name="bold" key="Alt+Shift+B" order="1" icon="">&lt;b&gt;${cursor}${selection}&lt;/b&gt;</fragment>
	<fragment block="false" name="italic" key="Alt+Shift+I" order="2" icon="">&lt;i&gt;${cursor}${selection}&lt;/i&gt;</fragment>
	<fragment block="false" name="codeph" key="Alt+Shift+K" order="3" icon="">&lt;codeph&gt;${cursor}${selection}&lt;/codeph&gt;</fragment>
	<fragment block="false" name="xref" key="Alt+Shift+X" order="4" icon="">&lt;xref href="${cursor}" format="dita"/&gt;</fragment>

	<!-- Lists -->
	<fragment block="true" name="ul" key="Alt+Shift+U" order="5" icon="">&lt;ul&gt;
	&lt;li&gt;${cursor}&lt;/li&gt;
	&lt;li&gt;&lt;/li&gt;
&lt;/ul&gt;</fragment>
	<fragment block="true" name="ol" key="Alt+Shift+O" order="6" icon="">&lt;ol&gt;
	&lt;li&gt;${cursor}&lt;/li&gt;
	&lt;li&gt;&lt;/li&gt;
&lt;/ol&gt;</fragment>
	<fragment block="true" name="dl" key="Alt+Shift+D" order="7" icon="">&lt;dl&gt;
	&lt;dlentry&gt;
		&lt;dt&gt;${cursor}&lt;/dt&gt;
		&lt;dd&gt;&lt;/dd&gt;
	&lt;/dlentry&gt;
&lt;/dl&gt;</fragment>

	<!-- Blocks -->
	<fragment block="true" name="section" key="Alt+Shift+S" order="8" icon="">&lt;section&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;p&gt;&lt;/p&gt;
&lt;/section&gt;</fragment>
	<fragment block="true" name="example" key="Alt+Shift+E" order="9" icon="">&lt;example&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;p&gt;&lt;/p&gt;
&lt;/example&gt;</fragment>
	<fragment block="true" name="codeblock" key="Alt+Shift+C" order="10" icon="">&lt;codeblock outputclass="language-xml"&gt;${cursor}&lt;/codeblock&gt;</fragment>
	<fragment block="true" name="note" key="Alt+Shift+N" order="11" icon="">&lt;note&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="true" name="note (warning)" key="Alt+Shift+W" order="12" icon="">&lt;note type="warning"&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="true" name="note (tip)" key="Alt+Shift+T" order="13" icon="">&lt;note type="tip"&gt;${cursor}&lt;/note&gt;</fragment>

	<!-- Table -->
	<fragment block="true" name="simpletable" key="Alt+Shift+L" order="14" icon="">&lt;simpletable&gt;
	&lt;sthead&gt;
		&lt;stentry&gt;${cursor}&lt;/stentry&gt;
		&lt;stentry&gt;&lt;/stentry&gt;
	&lt;/sthead&gt;
	&lt;strow&gt;
		&lt;stentry&gt;&lt;/stentry&gt;
		&lt;stentry&gt;&lt;/stentry&gt;
	&lt;/strow&gt;
&lt;/simpletable&gt;</fragment>
	<fragment block="true" name="table" key="Alt+Shift+A" order="15" icon="">&lt;table&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;tgroup cols="2"&gt;
		&lt;colspec colname="c1" colwidth="1.0*"/&gt;
		&lt;colspec colname="c2" colwidth="1.0*"/&gt;
		&lt;thead&gt;
			&lt;row&gt;
				&lt;entry&gt;&lt;/entry&gt;
				&lt;entry&gt;&lt;/entry&gt;
			&lt;/row&gt;
		&lt;/thead&gt;
		&lt;tbody&gt;
			&lt;row&gt;
				&lt;entry&gt;&lt;/entry&gt;
				&lt;entry&gt;&lt;/entry&gt;
			&lt;/row&gt;
		&lt;/tbody&gt;
	&lt;/tgroup&gt;
&lt;/table&gt;</fragment>

	<!-- Media -->
	<fragment block="true" name="image" key="Alt+Shift+G" order="16" icon="">&lt;image href="${cursor}" placement="break"&gt;
	&lt;alt&gt;&lt;/alt&gt;
&lt;/image&gt;</fragment>
	<fragment block="true" name="fig" key="Alt+Shift+F" order="17" icon="">&lt;fig&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;image href="" placement="break"&gt;
		&lt;alt&gt;&lt;/alt&gt;
	&lt;/image&gt;
&lt;/fig&gt;</fragment>

	<xpath name="Sections and Titles" xpath="//title | //section | //example | //conbody" default="false" showElementNames="true" showElementContent="true" showAttributes="false" showAttributeNames="false"/>
	<xpath name="Titles" xpath="//title" default="true" showElementNames="false" showElementContent="true" showAttributes="false" showAttributeNames="false"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
