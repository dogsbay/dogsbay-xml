<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Troubleshooting" icon="" publicID="-//OASIS//DTD DITA Troubleshooting//EN" systemID="troubleshooting.dtd" extensions="dita xml">
	<root name="troubleshooting">
		<namespace prefix="" uri=""/>
	</root>

	<!-- The shape of a troubleshooting topic: condition, then one or more cause/remedy pairs -->
	<fragment block="true" name="condition" key="Alt+Shift+C" order="0" icon="">&lt;condition&gt;
	&lt;p&gt;${cursor}&lt;/p&gt;
&lt;/condition&gt;</fragment>
	<fragment block="true" name="troubleSolution (cause + remedy)" key="Alt+Shift+S" order="1" icon="">&lt;troubleSolution&gt;
	&lt;cause&gt;
		&lt;p&gt;${cursor}&lt;/p&gt;
	&lt;/cause&gt;
	&lt;remedy&gt;
		&lt;steps&gt;
			&lt;step&gt;
				&lt;cmd&gt;&lt;/cmd&gt;
			&lt;/step&gt;
		&lt;/steps&gt;
	&lt;/remedy&gt;
&lt;/troubleSolution&gt;</fragment>
	<fragment block="true" name="cause" key="Alt+Shift+U" order="2" icon="">&lt;cause&gt;
	&lt;p&gt;${cursor}&lt;/p&gt;
&lt;/cause&gt;</fragment>
	<fragment block="true" name="remedy" key="Alt+Shift+R" order="3" icon="">&lt;remedy&gt;
	&lt;steps&gt;
		&lt;step&gt;
			&lt;cmd&gt;${cursor}&lt;/cmd&gt;
		&lt;/step&gt;
	&lt;/steps&gt;
&lt;/remedy&gt;</fragment>
	<fragment block="true" name="step" key="Alt+Shift+E" order="4" icon="">&lt;step&gt;
	&lt;cmd&gt;${cursor}&lt;/cmd&gt;
&lt;/step&gt;</fragment>
	<fragment block="true" name="responsibleParty" key="Alt+Shift+Y" order="5" icon="">&lt;responsibleParty&gt;${cursor}&lt;/responsibleParty&gt;</fragment>

	<!-- Blocks and inline -->
	<fragment block="true" name="paragraph" key="Alt+Shift+P" order="6" icon="">&lt;p&gt;${cursor}&lt;/p&gt;</fragment>
	<fragment block="true" name="note" key="Alt+Shift+N" order="7" icon="">&lt;note&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="false" name="bold" key="Alt+Shift+B" order="8" icon="">&lt;b&gt;${cursor}${selection}&lt;/b&gt;</fragment>
	<fragment block="false" name="uicontrol" key="Alt+Shift+I" order="9" icon="">&lt;uicontrol&gt;${cursor}${selection}&lt;/uicontrol&gt;</fragment>
	<fragment block="false" name="xref" key="Alt+Shift+X" order="10" icon="">&lt;xref href="${cursor}" format="dita"/&gt;</fragment>

	<xpath name="Causes and Remedies" xpath="//condition | //troubleSolution | //cause | //remedy" default="true" showElementNames="true" showElementContent="true" showAttributes="false" showAttributeNames="false"/>
	<xpath name="Titles" xpath="//title" default="false" showElementNames="false" showElementContent="true" showAttributes="false" showAttributeNames="false"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
