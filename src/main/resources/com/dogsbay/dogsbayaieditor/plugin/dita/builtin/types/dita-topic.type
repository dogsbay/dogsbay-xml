<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Topic" icon="" publicID="-//OASIS//DTD DITA Topic//EN" systemID="topic.dtd" extensions="dita xml">
	<root name="topic">
		<namespace prefix="" uri=""/>
	</root>

	<!-- Paragraph and inline -->
	<fragment block="true" name="paragraph" key="Alt+Shift+P" order="0" icon="">&lt;p&gt;${cursor}&lt;/p&gt;</fragment>
	<fragment block="false" name="bold" key="Alt+Shift+B" order="1" icon="">&lt;b&gt;${cursor}${selection}&lt;/b&gt;</fragment>
	<fragment block="false" name="italic" key="Alt+Shift+I" order="2" icon="">&lt;i&gt;${cursor}${selection}&lt;/i&gt;</fragment>
	<fragment block="false" name="codeph" key="Alt+Shift+K" order="3" icon="">&lt;codeph&gt;${cursor}${selection}&lt;/codeph&gt;</fragment>
	<fragment block="false" name="xref" key="Alt+Shift+X" order="4" icon="">&lt;xref href="${cursor}" format="dita"/&gt;</fragment>

	<!-- Lists -->
	<fragment block="true" name="ul" key="Alt+Shift+U" order="5" icon="">&lt;ul&gt;
	&lt;li&gt;${cursor}&lt;/li&gt;
	&lt;li&gt;&lt;/li&gt;
&lt;/ul&gt;</fragment>
	<fragment block="true" name="ol" key="Alt+Shift+O" order="6" icon="">&lt;ol&gt;
	&lt;li&gt;${cursor}&lt;/li&gt;
	&lt;li&gt;&lt;/li&gt;
&lt;/ol&gt;</fragment>

	<!-- Blocks -->
	<fragment block="true" name="section" key="Alt+Shift+S" order="7" icon="">&lt;section&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;p&gt;&lt;/p&gt;
&lt;/section&gt;</fragment>
	<fragment block="true" name="example" key="Alt+Shift+E" order="8" icon="">&lt;example&gt;
	&lt;title&gt;${cursor}&lt;/title&gt;
	&lt;p&gt;&lt;/p&gt;
&lt;/example&gt;</fragment>
	<fragment block="true" name="codeblock" key="Alt+Shift+C" order="9" icon="">&lt;codeblock outputclass="language-xml"&gt;${cursor}&lt;/codeblock&gt;</fragment>
	<fragment block="true" name="note" key="Alt+Shift+N" order="10" icon="">&lt;note&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="true" name="note (warning)" key="Alt+Shift+W" order="11" icon="">&lt;note type="warning"&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="true" name="note (tip)" key="Alt+Shift+T" order="12" icon="">&lt;note type="tip"&gt;${cursor}&lt;/note&gt;</fragment>

	<!-- Image -->
	<fragment block="true" name="image" key="Alt+Shift+G" order="13" icon="">&lt;image href="${cursor}" placement="break"&gt;
	&lt;alt&gt;&lt;/alt&gt;
&lt;/image&gt;</fragment>

	<xpath name="Sections and Titles" xpath="//title | //section | //example | //body" default="false" showElementNames="true" showElementContent="true" showAttributes="false" showAttributeNames="false"/>
	<xpath name="Titles" xpath="//title" default="true" showElementNames="false" showElementContent="true" showAttributes="false" showAttributeNames="false"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
