<?xml version="1.0" encoding="UTF-8"?>

<type name="DITA 1.3 Task" icon="" publicID="-//OASIS//DTD DITA Task//EN" systemID="task.dtd" extensions="dita xml">
	<root name="task">
		<namespace prefix="" uri=""/>
	</root>

	<!-- Inline -->
	<fragment block="false" name="bold" key="Alt+Shift+B" order="0" icon="">&lt;b&gt;${cursor}${selection}&lt;/b&gt;</fragment>
	<fragment block="false" name="italic" key="Alt+Shift+I" order="1" icon="">&lt;i&gt;${cursor}${selection}&lt;/i&gt;</fragment>
	<fragment block="false" name="codeph" key="Alt+Shift+K" order="2" icon="">&lt;codeph&gt;${cursor}${selection}&lt;/codeph&gt;</fragment>
	<fragment block="false" name="uicontrol" key="Alt+Shift+U" order="3" icon="">&lt;uicontrol&gt;${cursor}${selection}&lt;/uicontrol&gt;</fragment>
	<fragment block="false" name="menucascade" key="Alt+Shift+M" order="4" icon="">&lt;menucascade&gt;&lt;uicontrol&gt;${cursor}&lt;/uicontrol&gt;&lt;uicontrol&gt;&lt;/uicontrol&gt;&lt;/menucascade&gt;</fragment>
	<fragment block="false" name="xref" key="Alt+Shift+X" order="5" icon="">&lt;xref href="${cursor}" format="dita"/&gt;</fragment>

	<!-- Step structures -->
	<fragment block="true" name="step" key="Alt+Shift+S" order="6" icon="">&lt;step&gt;
	&lt;cmd&gt;${cursor}&lt;/cmd&gt;
&lt;/step&gt;</fragment>
	<fragment block="true" name="step with info" key="Alt+Shift+T" order="7" icon="">&lt;step&gt;
	&lt;cmd&gt;${cursor}&lt;/cmd&gt;
	&lt;info&gt;&lt;p&gt;&lt;/p&gt;&lt;/info&gt;
&lt;/step&gt;</fragment>
	<fragment block="true" name="substeps" key="Alt+Shift+Q" order="8" icon="">&lt;substeps&gt;
	&lt;substep&gt;
		&lt;cmd&gt;${cursor}&lt;/cmd&gt;
	&lt;/substep&gt;
	&lt;substep&gt;
		&lt;cmd&gt;&lt;/cmd&gt;
	&lt;/substep&gt;
&lt;/substeps&gt;</fragment>
	<fragment block="true" name="choicetable" key="Alt+Shift+H" order="9" icon="">&lt;choicetable&gt;
	&lt;chhead&gt;
		&lt;choptionhd&gt;Option&lt;/choptionhd&gt;
		&lt;chdeschd&gt;Description&lt;/chdeschd&gt;
	&lt;/chhead&gt;
	&lt;chrow&gt;
		&lt;choption&gt;${cursor}&lt;/choption&gt;
		&lt;chdesc&gt;&lt;/chdesc&gt;
	&lt;/chrow&gt;
&lt;/choicetable&gt;</fragment>

	<!-- Blocks -->
	<fragment block="true" name="paragraph" key="Alt+Shift+P" order="10" icon="">&lt;p&gt;${cursor}&lt;/p&gt;</fragment>
	<fragment block="true" name="ul" key="Alt+Shift+L" order="11" icon="">&lt;ul&gt;
	&lt;li&gt;${cursor}&lt;/li&gt;
	&lt;li&gt;&lt;/li&gt;
&lt;/ul&gt;</fragment>
	<fragment block="true" name="codeblock" key="Alt+Shift+C" order="12" icon="">&lt;codeblock outputclass="language-xml"&gt;${cursor}&lt;/codeblock&gt;</fragment>
	<fragment block="true" name="note" key="Alt+Shift+N" order="13" icon="">&lt;note&gt;${cursor}&lt;/note&gt;</fragment>
	<fragment block="true" name="note (warning)" key="Alt+Shift+W" order="14" icon="">&lt;note type="warning"&gt;${cursor}&lt;/note&gt;</fragment>

	<!-- Image -->
	<fragment block="true" name="image" key="Alt+Shift+G" order="15" icon="">&lt;image href="${cursor}" placement="break"&gt;
	&lt;alt&gt;&lt;/alt&gt;
&lt;/image&gt;</fragment>

	<xpath name="Steps" xpath="//step/cmd | //result | //prereq | //context" default="false" showElementNames="true" showElementContent="true" showAttributes="false" showAttributeNames="false"/>
	<xpath name="Titles" xpath="//title" default="true" showElementNames="false" showElementContent="true" showAttributes="false" showAttributeNames="false"/>

	<validation src="" type="dtd" useDocumentLocation="true"/>
</type>
