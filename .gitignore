target/
# Anchored, and one level down for the modules: a bare "build/" matches a directory of
# that name anywhere, which quietly swallowed a src/test/java/com/dogsbay/build package —
# the test in it ran locally and could never have been committed.
/build/
*/build/
build.log
.gradle/
.vscode/
.idea/
*.iml
.DS_Store
bin/*
!bin/dogsbay-xml
.settings/
analyze-jars.sh

# Development/debugging files
ag/
fix-jtextcomponent.py
projects/all.projects.minimal

__pycache__/

# xagent-core's jar is this build's own output, copied into lib/ by syncLib for
# the dev launchers (run.sh, bin/dogsbay-xml). Its name carries the version, so
# committing it would leave a stale copy behind at every release. Third-party
# jars in lib/ stay committed, as they always have.
lib/xagent-core-*.jar

# lib/ is two things at once. Jars Gradle resolves from Maven are copied here
# by syncLib purely so the dev launchers can use `lib/*`; they are build output
# and are NOT committed, because a stale copy left after a version bump wins
# silently on that classpath. Jars with no Maven artifact are source and are
# listed below. `./gradlew checkLib` fails if the two ever get mixed up.
lib/*.jar
!lib/AppleJavaExtensions.jar
!lib/bounce.jar
!lib/commons.jar
!lib/dita-index.jar
!lib/dom4j.jar
!lib/dost-configuration.jar
!lib/dost.jar
!lib/jaxen-1.1.1.jar
!lib/jdom.jar
!lib/l2fprod-common-directorychooser.jar
!lib/l2fprod-common-totd.jar
!lib/nekohtml.jar
# org.lwdita: DITA-OT's Markdown/LwDITA reader, not published to Maven.
!lib/org.lwdita-5.9.1.jar
# htmlparser 1.4, which org.lwdita's HDITA reader needs: Maven's line starts at 1.4.1,
# and the classes that reader calls are not in any published version.
!lib/htmlparser-1.4.jar
!lib/poi.jar
!lib/rome-0.9.jar
!lib/rome-fetcher-0.9.jar

# ── Not part of the build ────────────────────────────────────────────────────
# The user and developer documentation lives on the website, and the planning
# notes are working material. Both stay on disk for anyone who has them; they
# are simply not carried in this repository, which holds what it takes to
# build, test and package the editor.
docs/
docs-dev/
plans/

# Generated by ./gradlew syncLib from whatever is in lib/, for the legacy
# loader that run.sh uses. Committing it means a diff on every dependency
# change, and a stale copy is worse than none.
loader.properties

# JVM crash logs and core dumps
hs_err_pid*.log
replay_pid*.log
core.*
